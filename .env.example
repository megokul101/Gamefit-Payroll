# Vercel environment variables. Keep real values out of Git.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
APP_ORIGIN=https://YOUR-PROJECT.vercel.app
GAMEFIT_ADMIN_PASSWORD_HASH=GENERATE_WITH_scripts_make_admin_hash.py
GAMEFIT_SESSION_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
GAMEFIT_DEVICE_SYNC_TOKEN=GENERATE_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Local bridge environment only (do not put the database URL or admin login on the device).
GAMEFIT_CLOUD_URL=https://YOUR-PROJECT.vercel.app
GAMEFIT_DEVICE_IP=192.168.1.40
GAMEFIT_DEVICE_PORT=4370
GAMEFIT_COMM_KEY=0
GAMEFIT_SYNC_INTERVAL=60
